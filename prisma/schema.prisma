// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------
// Enums (กำหนดค่าคงที่เพื่อป้องกันการพิมพ์ผิดใน Database)
// -------------------------------------------------
enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

// -------------------------------------------------
// Models
// -------------------------------------------------

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  gender        Gender?   
  birthYear     Int?      
  height        Float?    
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  weightLogs    WeightLog[]
  foodLogs      FoodLog[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}
 
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
}

model WeightLog {
  id          String   @id @default(uuid())
  userId      String
  
  weight      Float    // น้ำหนัก ณ วันที่บันทึก (kg)
  bmi         Float    // ค่า BMI ที่คำนวณได้ ณ ตอนนั้น
  
  // Relation
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  recordedAt  DateTime @default(now()) // วันที่บันทึกข้อมูล

  // Index เพื่อให้ดึงข้อมูลประวัติน้ำหนักของ User ได้เร็วขึ้น
  @@index([userId])
}

model FoodLog {
  id          String   @id @default(uuid())
  userId      String
  
  mealType    MealType
  foodName    String
  calories    Int      // แคลอรีที่คำนวณได้จาก AI
  imageUrl    String?  // ลิงก์รูปภาพที่อัปโหลด (เก็บเป็น URL จาก Storage)
  
  // Relation
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  recordedAt  DateTime @default(now()) // วันที่บันทึกการกิน

  @@index([userId])
  @@index([recordedAt]) // Index ไว้สำหรับการดึงข้อมูลสรุปแคลอรี "รายวัน" ให้เร็วขึ้น
}